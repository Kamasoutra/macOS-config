# ─── Bitwarden session management ────────────────────────────────────────────
BW_SESSION_FILE="$HOME/.bw_session"

# Restaure la session silencieusement au démarrage du shell si elle est encore valide
if command -v bw &>/dev/null && [ -f "$BW_SESSION_FILE" ]; then
  _bw_stored=$(cat "$BW_SESSION_FILE")
  if bw unlock --check --session "$_bw_stored" &>/dev/null; then
    export BW_SESSION="$_bw_stored"
  fi
  unset _bw_stored
fi

# bwu : déverrouille le vault et sauvegarde la session
bwu() {
  if [ -n "$BW_SESSION" ] && bw unlock --check --session "$BW_SESSION" &>/dev/null; then
    echo "🔐 Bitwarden : session déjà active"
    return 0
  fi
  echo "🔐 Bitwarden : déverrouillage..."
  export BW_SESSION=$(bw unlock --raw)
  if [ -n "$BW_SESSION" ]; then
    echo "$BW_SESSION" > "$BW_SESSION_FILE"
    chmod 600 "$BW_SESSION_FILE"
    echo "✅ Session sauvegardée"
  else
    echo "❌ Échec du déverrouillage"
    return 1
  fi
}

# bwlock : verrouille et supprime la session
bwlock() {
  bw lock
  rm -f "$BW_SESSION_FILE"
  unset BW_SESSION
  echo "🔒 Bitwarden verrouillé"
}

# bw_sync_config : sync le fichier macOS-config-variables vers Bitwarden
# Usage : bw_sync_config [chemin/vers/fichier]
BW_CONFIG_FILE="${HOME}/dev_perso/macOS-config/macOS-config-variables"
bw_sync_config() {
  local file="${1:-$BW_CONFIG_FILE}"
  local name="macOS-config-variables"

  if [ ! -f "$file" ]; then
    echo "❌ Fichier introuvable : $file"
    return 1
  fi

  bwu || return 1

  local content=$(< "$file")
  local item_id=$(bw get item "$name" --session "$BW_SESSION" 2>/dev/null | jq -r '.id // empty')

  if [ -n "$item_id" ]; then
    bw get item "$name" --session "$BW_SESSION" | \
      jq --arg content "$content" '.notes = $content' | \
      bw encode | bw edit item "$item_id" --session "$BW_SESSION" > /dev/null
    echo "✅ Bitwarden : '$name' mis à jour"
  else
    bw get template item | \
      jq --arg content "$content" \
        '.type = 2 | .name = "macOS-config-variables" | .notes = $content | .secureNote = {"type": 0}' | \
      bw encode | bw create item --session "$BW_SESSION" > /dev/null
    echo "✅ Bitwarden : '$name' créé"
  fi
}

