gcleaner() {
    echo ""
    echo "\033[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
    echo "\033[1;36m         🧹 Git Cleaner - Nettoyage du dépôt\033[0m"
    echo "\033[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
    echo ""

    # Branche par défaut
    default_branch=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed "s@^refs/remotes/origin/@@" || git branch -r | grep -oE "origin/(main|master|production)" | head -1 | sed "s@origin/@@")
    current_branch=$(git rev-parse --abbrev-ref HEAD)

    echo "📍 État actuel"
    echo "   ├─ Branche par défaut : \033[1;36m$default_branch\033[0m"
    echo "   └─ Branche courante   : \033[1;33m$current_branch\033[0m"
    echo ""

    # Vérifier si la branche a un upstream
    tracking=$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null)

    if [[ -z "$tracking" ]]; then
        echo "⚠️  \033[1;31mAlerte\033[0m : La branche '\033[1m$current_branch\033[0m' n'existe plus sur le remote"
        echo ""
        echo -n "   Supprimer la branche et basculer sur \033[1;36m$default_branch\033[0m ? [\033[1;32my\033[0m/\033[1;31mN\033[0m] : "
        read choice

        if [[ "$choice" =~ ^[yY]$ ]]; then
            echo ""
            echo "🔄 Basculement sur \033[1;36m$default_branch\033[0m..."
            git checkout "$default_branch" || { echo "\n❌ Échec du checkout !"; return 1; }

            echo ""
            echo "🗑️  Suppression de la branche locale \033[1;31m$current_branch\033[0m..."
            git branch -D "$current_branch"
            current_branch="$default_branch"
            echo "✅ Branche supprimée avec succès"
        else
            echo ""
            echo "⏭️  Conservation de la branche locale '\033[1;33m$current_branch\033[0m'"
            echo "   ℹ️  Pull impossible (pas de remote)"
        fi
    else
        # Interaction classique pour checkout par défaut si souhaité
        if [[ "$current_branch" != "$default_branch" ]]; then
            echo "💡 Tu es actuellement sur une branche de développement"
            echo ""
            echo -n "   Basculer sur \033[1;36m$default_branch\033[0m avant le nettoyage ? [\033[1;32my\033[0m/\033[1;31mN\033[0m] : "
            read choice2

            if [[ "$choice2" =~ ^[yY]$ ]]; then
                echo ""
                echo "🔄 Basculement sur \033[1;36m$default_branch\033[0m..."
                git checkout "$default_branch" || { echo "\n❌ Échec du checkout !"; return 1; }
                current_branch="$default_branch"
                echo "✅ Basculement réussi"
            else
                echo ""
                echo "⏭️  Conservation de la branche : \033[1;33m$current_branch\033[0m"
            fi
        fi
    fi

    echo ""
    echo "\033[2m─────────────────────────────────────────────────────────────\033[0m"
    echo ""

    # Stash si nécessaire AVANT le fetch
    if [[ -n $(git status --porcelain) ]]; then
        echo "💾 Modifications locales détectées"
        echo ""
        echo -n "   Créer un stash temporaire ? [\033[1;32my\033[0m/\033[1;31mN\033[0m] : "
        read stash_choice

        if [[ "$stash_choice" =~ ^[yY]$ ]]; then
            echo ""
            git stash push -m "gcleaner-auto-stash-$(date +%s)"
            stash_created=true
            echo "✅ Stash créé"
            echo ""
        else
            stash_created=false
            echo ""
            echo "⏭️  Modifications conservées"
            echo ""
        fi
    else
        stash_created=false
    fi

    # Fetch + prune
    echo "🌐 Synchronisation avec le remote..."
    git fetch --all -p
    echo "✅ Fetch et prune terminés"
    echo ""

    # Pull IMMÉDIATEMENT après le fetch
    tracking=$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null)
    if [[ -n "$tracking" ]]; then
        echo "⬇️  Mise à jour de la branche \033[1;36m$current_branch\033[0m..."
        git pull --rebase || { echo "❌ Échec du pull !"; return 1; }
        echo "✅ Pull réussi"
        echo ""
    fi

    # Nettoyage branches locales temporaires
    echo "🔍 Recherche de branches locales à nettoyer..."
    branches_to_delete=$(git branch | grep -vE "^\*|^  ($default_branch|master|main|production|staging)")

    if [[ -n "$branches_to_delete" ]]; then
        echo "🗑️  Suppression des branches temporaires :"
        echo "$branches_to_delete" | sed 's/^/   ├─ /'
        echo "$branches_to_delete" | xargs -r git branch -D > /dev/null 2>&1
        echo "   └─ \033[1;32m✓\033[0m Suppression terminée"
    else
        echo "✨ Aucune branche temporaire à supprimer"
    fi
    echo ""

    # Nettoyage des fichiers non trackés
    untracked_files=$(git ls-files --others --exclude-standard)
    if [[ -n "$untracked_files" ]]; then
        echo "🗂️  Fichiers non trackés détectés :"
        echo "$untracked_files" | head -5 | sed 's/^/   ├─ /'
        if [[ $(echo "$untracked_files" | wc -l) -gt 5 ]]; then
            echo "   └─ ... et $(($(echo "$untracked_files" | wc -l) - 5)) autre(s)"
        fi
        echo ""
        echo -n "   Supprimer ces fichiers ? [\033[1;32my\033[0m/\033[1;31mN\033[0m] : "
        read clean_choice

        if [[ "$clean_choice" =~ ^[yY]$ ]]; then
            echo ""
            echo "🧹 Suppression des fichiers non trackés..."
            git clean -fd
            echo "✅ Fichiers supprimés"
        else
            echo ""
            echo "⏭️  Fichiers non trackés conservés"
        fi
        echo ""
    fi

    # Gérer le stash si créé
    if $stash_created; then
        echo -n "   Restaurer le stash ? [\033[1;32my\033[0m/\033[1;31mN\033[0m] : "
        read stash_restore

        if [[ "$stash_restore" =~ ^[yY]$ ]]; then
            echo ""
            echo "📦 Restauration du stash..."
            git stash pop
            echo "✅ Stash restauré"
        else
            echo ""
            echo "💾 Stash conservé (utilise 'git stash list' pour le voir)"
        fi
        echo ""
    fi

    echo "\033[1;32m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
    echo "\033[1;32m    🎉 Nettoyage terminé avec succès !\033[0m"
    echo "\033[1;32m    📍 Branche active : \033[1;36m$current_branch\033[0m"
    echo "\033[1;32m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
    echo ""
}

